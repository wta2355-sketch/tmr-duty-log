{
  "rules": {
    ".read": false,
    ".write": false,
    "dutyLogs": {
      ".read": "auth != null && (auth.token.email === 'duty@gjtmr.local' || auth.token.email === 'manager@gjtmr.local' || auth.token.email === 'director@gjtmr.local')",
      "$date": {
        "log": {
          ".write": "auth != null && auth.token.email === 'duty@gjtmr.local' && $date.matches(/^\\d{4}-\\d{2}-\\d{2}$/) && !data.parent().child('review/manager').exists() && !data.parent().child('review/director').exists()",
          ".validate": "newData.child('date').val() === $date && newData.child('worker').isString() && newData.child('worker').val().length > 0 && (!newData.child('sig').exists() || (newData.child('sig').isString() && newData.child('sig').val().beginsWith('data:image/png;base64,') && newData.child('sig').val().length < 80000))"
        },
        "review": {
          "manager": {
            ".write": "auth != null && auth.token.email === 'manager@gjtmr.local' && data.parent().parent().child('log/sig').exists()",
            ".validate": "newData.hasChildren(['name', 'at', 'sig']) && newData.child('sig').isString() && newData.child('sig').val().beginsWith('data:image/png;base64,') && newData.child('sig').val().length < 80000"
          },
          "director": {
            ".write": "auth != null && auth.token.email === 'director@gjtmr.local' && data.parent().parent().child('log/sig').exists()",
            ".validate": "newData.hasChildren(['name', 'at', 'sig']) && newData.child('sig').isString() && newData.child('sig').val().beginsWith('data:image/png;base64,') && newData.child('sig').val().length < 80000"
          },
          "$other": {
            ".write": false
          }
        },
        "ack": {
          "$r": {
            ".write": "auth != null && auth.token.email === 'duty@gjtmr.local' && ($r === 'manager' || $r === 'director') && data.parent().parent().child('review/' + $r).exists()",
            ".validate": "newData.hasChildren(['at'])"
          }
        },
        "seen": {
          "manager": {
            ".write": "auth != null && auth.token.email === 'manager@gjtmr.local'",
            ".validate": "newData.hasChildren(['at'])"
          },
          "director": {
            ".write": "auth != null && auth.token.email === 'director@gjtmr.local'",
            ".validate": "newData.hasChildren(['at'])"
          }
        },
        "pre": {
          "$r": {
            ".write": "auth != null && $date.matches(/^\\d{4}-\\d{2}-\\d{2}$/) && (($r === 'manager' && auth.token.email === 'manager@gjtmr.local') || ($r === 'director' && auth.token.email === 'director@gjtmr.local'))",
            ".validate": "newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length < 2000 && newData.child('at').isString()"
          }
        },
        "preAck": {
          "$r": {
            ".write": "auth != null && auth.token.email === 'duty@gjtmr.local' && data.parent().parent().child('pre/' + $r).exists()",
            ".validate": "newData.hasChildren(['at'])"
          }
        },
        "$other": {
          ".write": false
        }
      }
    },
    "dutyPhotos": {
      ".read": "auth != null && (auth.token.email === 'duty@gjtmr.local' || auth.token.email === 'manager@gjtmr.local' || auth.token.email === 'director@gjtmr.local')",
      "$date": {
        "$r": {
          "$pid": {
            ".write": "auth != null && auth.token.email === 'duty@gjtmr.local' && $date.matches(/^\\d{4}-\\d{2}-\\d{2}$/) && ($r === 'r1' || $r === 'r2' || $r === 'r3') && !root.child('dutyLogs/' + $date + '/review/manager').exists() && !root.child('dutyLogs/' + $date + '/review/director').exists()",
            ".validate": "newData.child('data').isString() && newData.child('data').val().beginsWith('data:image/jpeg;base64,') && newData.child('data').val().length < 500000 && newData.child('at').isString()"
          }
        }
      }
    },
    "dutyStaff": {
      ".read": "auth != null && (auth.token.email === 'duty@gjtmr.local' || auth.token.email === 'manager@gjtmr.local' || auth.token.email === 'director@gjtmr.local')",
      ".write": "auth != null && (auth.token.email === 'duty@gjtmr.local' || auth.token.email === 'manager@gjtmr.local' || auth.token.email === 'director@gjtmr.local')"
    },
    "dutyRoster": {
      ".read": "auth != null && (auth.token.email === 'duty@gjtmr.local' || auth.token.email === 'manager@gjtmr.local' || auth.token.email === 'director@gjtmr.local')",
      "$month": {
        ".validate": "$month.matches(/^\\d{4}-\\d{2}$/) && newData.hasChildren(['days', 'updatedAt'])",
        "days": {
          ".write": "auth != null && (auth.token.email === 'duty@gjtmr.local' || auth.token.email === 'manager@gjtmr.local' || auth.token.email === 'director@gjtmr.local')"
        },
        "updatedAt": {
          ".write": "auth != null && (auth.token.email === 'duty@gjtmr.local' || auth.token.email === 'manager@gjtmr.local' || auth.token.email === 'director@gjtmr.local')"
        },
        "updatedBy": {
          ".write": "auth != null && (auth.token.email === 'duty@gjtmr.local' || auth.token.email === 'manager@gjtmr.local' || auth.token.email === 'director@gjtmr.local')"
        },
        "approve": {
          "manager": {
            ".write": "auth != null && auth.token.email === 'manager@gjtmr.local'",
            ".validate": "newData.hasChildren(['sig', 'at']) && newData.child('sig').isString() && newData.child('sig').val().beginsWith('data:image/png;base64,') && newData.child('sig').val().length < 80000"
          },
          "director": {
            ".write": "auth != null && auth.token.email === 'director@gjtmr.local'",
            ".validate": "newData.hasChildren(['sig', 'at']) && newData.child('sig').isString() && newData.child('sig').val().beginsWith('data:image/png;base64,') && newData.child('sig').val().length < 80000"
          },
          "$other": {
            ".write": false
          }
        },
        "$other": {
          ".write": false
        }
      }
    },
    "dutySigs": {
      ".read": "auth != null && (auth.token.email === 'duty@gjtmr.local' || auth.token.email === 'manager@gjtmr.local' || auth.token.email === 'director@gjtmr.local')",
      "$name": {
        ".write": "auth != null && (auth.token.email === 'duty@gjtmr.local' || auth.token.email === 'manager@gjtmr.local' || auth.token.email === 'director@gjtmr.local')",
        ".validate": "$name.length >= 2 && $name.length <= 6 && newData.hasChildren(['sig','at','consent']) && newData.child('consent').val() === true && newData.child('sig').isString() && newData.child('sig').val().beginsWith('data:image/png;base64,') && newData.child('sig').val().length < 80000"
      }
    }
  }
}
